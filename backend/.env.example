# Copy to .env (or export as AIRE_* env vars) to override defaults in app/config.py.
# Everything below is optional — the app runs with zero configuration,
# using SQLite and the offline LLM provider.

AIRE_DATABASE_URL=sqlite:///./aire.db
# AIRE_DATABASE_URL=postgresql+psycopg2://aire:aire@localhost:5432/aire

AIRE_LLM_PROVIDER=auto
AIRE_GEMINI_API_KEY=
AIRE_GEMINI_MODEL=gemini-2.0-flash
AIRE_OLLAMA_HOST=http://localhost:11434
AIRE_OLLAMA_MODEL=llama3.2:3b

AIRE_MAX_ITERATIONS=15
AIRE_MAX_SECONDS=120
AIRE_MAX_TOKENS=60000

AIRE_AUTO_APPROVE_LOW_RISK=true
